@savestate slot 1
@controller {
    shot        = Y          ; default X
    jump        = A          ; default A
    dash        = X          ; default B
    item_select = Select     ; default Select
    item_cancel = B          ; default Y
    angle_up    = R          ; default R
    angle_down  = L          ; default L
}

@routine armpump_left {
    repeat 60 {
        Left+X+R
		Left+X
        Left+X+L
		Left+X
    }
}

@routine armpump_right {
    repeat 60 {
        Right+X+R
		Right+X
        Right+X+L
		Right+X
    }
}

assert room == $91F8 "Landing Site?"
assert game_state == 8

label "Landing Site"
Left+X 30
Left+X+A 15
Left+X 40

call armpump_left
call armpump_right

;label "Jump + Shoot"
;# Pula e atira algumas vezes
;repeat 8 {
;    Left+X+A+Y 16
;    Left+X+Y   8
;}

# Corre e atira até atravessar a porta
label "Run + Shoot"
wait_until game_state == $0B hold Left+X+Y timeout 400
wait_until game_state == 8 timeout 300

label "Parlor"
. 60
assert room != $91F8 "Saiu de Landing Site"
. 60
