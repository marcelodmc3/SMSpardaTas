@savestate slot 1

assert room == $91F8 "É Landing Site?"
assert game_state == 8

label "Landing Site"
Left+B 30              ; start running left
Left+B+A 15            ; running jump
Left+B 40

label "Pulo + Tiro"
# Pula e atira algumas vezes
repeat 8 {
    Left+B+A+X 16
    Left+B+X   8
}

# Corre e atira até atravessar a porta
label "Corre + Tiro"
wait_until game_state == $0B hold Left+B+X timeout 400
wait_until game_state == 8 timeout 300

label "Parlor"
. 60
assert room != $91F8 "Saiu de Landing Site"
. 60
